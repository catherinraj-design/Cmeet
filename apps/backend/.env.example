PROJECT_NAME="School ERP - Video Conferencing Module (Cmeet)"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL for production, SQLite for local testing)
DATABASE_URL="sqlite+aiosqlite:///./cmeet.db"
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/school_erp"

# JWT & Authentication Secret
SECRET_KEY="school-erp-super-secret-key-change-in-production-32bytes-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# LiveKit Cloud / Managed Server Credentials
LIVEKIT_URL="https://cmeet-test.livekit.cloud"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_TOKEN_TTL_MINUTES=60
LIVEKIT_WEBHOOK_SECRET="secret"
